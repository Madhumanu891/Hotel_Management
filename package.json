{
  "name": "hotel-management-system",
  "version": "1.0.0",
  "description": "Enterprise Multi-Property Hotel Management System",
  "private": true,
    "scripts": {
    "health":     "node scripts/health-check.js",
    "test:auth":  "cd auth-service && npm test",
    "test:prop":  "cd property-service && npm test",
    "test:all":   "npm run test:auth && npm run test:prop",
    "build":      "cd frontend && npm run build",
    "docker:up":  "docker-compose up -d",
    "docker:down":"docker-compose down",
    "docker:logs":"docker-compose logs -f"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "amqplib": "^0.10.9",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.0",
    "morgan": "^1.10.1",
    "nodemailer": "^8.0.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
