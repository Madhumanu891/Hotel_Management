NODE_ENV=development
PORT=3001
SERVICE_NAME=auth-service

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/hotel_auth_db

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://admin:admin123@localhost:5672

# JWT Secrets — use long random strings in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=change_this_to_a_long_random_string_in_production
REFRESH_TOKEN_SECRET=change_this_to_a_different_long_random_string

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Frontend URL
CLIENT_URL=http://localhost:5173
